---
import Section from "../components/layout/Section.astro";
import Container from "../components/layout/Container.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import EmailCapture from "../components/ui/EmailCapture.astro";
interface Props {
  /** Anchor destination for the offer. */
  id?: string;
  /** Offer details under the heading. */
  lead?: string;
  /** The closing invitation, from the source. */
  heading: string;
  /** Accessible email field label. */
  emailLabel: string;
  /** Email prompt shown in the field. */
  emailPlaceholder: string;
  /** Signup button copy. */
  buttonLabel: string;
}
const { heading, emailLabel, emailPlaceholder, buttonLabel, id, lead } = Astro.props;
---
<Section id={id} class="closing-band scroll-mt-20">
  <Container class="flex flex-col items-center gap-6">
    <SectionHeader heading={heading} lead={lead} size="h3" align="center" />
    <EmailCapture label={emailLabel} placeholder={emailPlaceholder} button={buttonLabel} class="closing-capture" />
  </Container>
</Section>
<style>
  :global(.closing-band h2) { font-size: var(--text-h4); }
  :global(.closing-band) :global(form) { max-width: var(--container-measure-md); }
  :global(.closing-band) :global(form button) { height: 3.25rem; border-radius: var(--radius-md); }
  @media (width < 1024px) {
    :global(.closing-band) :global(form) { flex-direction: column; gap: .5rem; }
    :global(.closing-band) :global(form > *) { width: 100%; }
    :global(.closing-band) :global(form input) { border-radius: var(--radius-sm); text-align: center; }
  }
</style>
