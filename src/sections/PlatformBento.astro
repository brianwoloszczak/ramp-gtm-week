---
import type { ImageMetadata } from "astro";
import Section from "../components/layout/Section.astro";
import Container from "../components/layout/Container.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import type { Action } from "../components/ui/SectionHeader.astro";
import Heading from "../components/ui/Heading.astro";
import Photo from "../components/ui/Photo.astro";
import Icon from "../components/ui/Icon.astro";
import { ArrowUpRight } from "@lucide/astro";
interface Tile {
  /** Product name from the source. */
  title: string;
  /** Muted continuation of the product heading. */
  description: string;
  /** Product destination. */
  href: string;
  /** Genuine source product artwork. */
  image: ImageMetadata;
  /** Source mobile composition for wide animated artwork. */
  mobileImage?: ImageMetadata;
  /** Accessible description of the product artwork. */
  imageAlt: string;
}
interface Props {
  /** Main section heading. */
  heading: string;
  /** Muted second clause of the heading. */
  muted: string;
  /** Source's two calls to action. */
  actions: Action[];
  /** The five products, in source order. */
  tiles: Tile[];
}
const { heading, muted, actions, tiles } = Astro.props;
---
<Section>
  <Container class="flex flex-col gap-12 md:gap-16">
    <SectionHeader heading={heading} muted={muted} actions={actions} class="platform-header" />
    <div class="platform-grid grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-6">
      {tiles.map((tile, index) => (
        <a href={tile.href} class:list={["platform-tile relative block w-full min-w-0 overflow-hidden rounded-lg border border-line bg-surface-2 text-ink-1 transition-colors hover:border-line-2 focus-visible:border-line-brand focus-visible:outline-none", index < 2 ? "platform-large lg:col-span-3" : "lg:col-span-2"]}>
          <Photo src={tile.image} alt={tile.imageAlt} ratio={index < 2 ? "4/3" : "3/4"} sizes={index < 2 ? "(min-width: 768px) 50vw, 100vw" : "(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"} class={tile.mobileImage ? "platform-art hidden lg:block" : "platform-art"} />
          {tile.mobileImage && <Photo src={tile.mobileImage} alt={tile.imageAlt} ratio="3/4" sizes="(min-width: 768px) 50vw, 100vw" class="platform-art lg:hidden" />}
          <div class="relative z-10 flex items-start justify-between gap-4 p-6 lg:p-8">
            <Heading level={3} size="h4" class="max-w-measure-sm">{tile.title}<span class="text-ink-3"> {tile.description}</span></Heading>
            <span class="flex size-9 shrink-0 items-center justify-center rounded-sm border border-line bg-surface-3"><Icon icon={ArrowUpRight} size="sm" /></span>
          </div>
        </a>
      ))}
    </div>
  </Container>
</Section>
<style>
  :global(.platform-header) { max-width: none; }
  .platform-tile { aspect-ratio: 4 / 5; min-height: 25rem; }
  :global(.platform-art) { position: absolute; inset: 0; width: 100%; height: 100%; }
  @media (min-width: 768px) { .platform-large { min-height: 32rem; } }
  @media (min-width: 1024px) { .platform-large { aspect-ratio: 4 / 3; min-height: 30rem; } }
</style>
