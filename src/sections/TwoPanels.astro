---
import type { ImageMetadata } from "astro";
import Section from "../components/layout/Section.astro";
import Container from "../components/layout/Container.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import Heading from "../components/ui/Heading.astro";
import Photo from "../components/ui/Photo.astro";
import Link from "../components/ui/Link.astro";

export interface VisibilityPanel {
  /** The panel's source heading. */
  heading: string;
  /** The explanation beneath the heading. */
  text: string;
  /** Original product illustration supplied by the page. */
  image: ImageMetadata;
  /** Description of the original illustration. */
  imageAlt: string;
  /** The mobile demonstration link shown on the second panel. */
  action?: { label: string; href: string };
}
interface Props {
  /** The heading shared by the two visibility panels. */
  heading: string;
  /** Two panels in their original reading order. */
  panels: [VisibilityPanel, VisibilityPanel];
}
const { heading, panels } = Astro.props;
---
<Section>
  <Container class="flex flex-col gap-10 md:gap-12 lg:gap-16">
    <SectionHeader heading={heading} align="center" />
    <div class="grid grid-cols-1 gap-6 lg:mx-10 lg:grid-cols-2">
      {panels.map((panel, i) => (
        <article class="flex min-w-0 flex-col overflow-hidden rounded-xl bg-surface-2 lg:min-h-180">
          <div class="flex flex-col gap-4 px-6 pt-8 lg:px-10 lg:pt-10">
            <Heading level={3} size="h3">{panel.heading}</Heading>
            <p class="max-w-measure-md text-regular text-ink-2">{panel.text}</p>
            {panel.action && <Link href={panel.action.href} variant="arrow">{panel.action.label}</Link>}
          </div>
          <div class:list={["mt-8 lg:mt-auto", i === 0 && "px-6 pb-8 lg:px-10 lg:pb-18"]}>
            <Photo src={panel.image} alt={panel.imageAlt} ratio="4/3" position="top" sizes="(min-width: 1024px) 45vw, 100vw" class="bg-surface-2" />
          </div>
        </article>
      ))}
    </div>
  </Container>
</Section>
