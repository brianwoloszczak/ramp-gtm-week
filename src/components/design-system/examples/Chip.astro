---
import DsBlock from "../DsBlock.astro";
import DsStage from "../DsStage.astro";
import DsState from "../DsState.astro";
import DsProps from "../DsProps.astro";
import Chip from "../../ui/Chip.astro";

interface Props {
  /** A small preview for the overview grid. */
  thumb?: boolean;
}
const { thumb = false } = Astro.props;
---

{
  thumb ? (
    <div class="flex flex-wrap justify-center gap-2"><Chip>Products</Chip><Chip>Solutions</Chip><Chip href="#" selected>Products</Chip></div>
  ) : (
    <>
      <DsBlock title="Tags" description="sm on a card, md in a row of their own. Write the label in normal case.">
        <DsStage>
          <Chip>Products</Chip>
          <Chip>Solutions</Chip>
          <Chip size="md">Platform</Chip>
        </DsStage>
      </DsBlock>
      <DsBlock title="A filter" description="With href each is a link; selected marks the chosen one.">
        <DsStage layout="states" cols={4}>
          <DsState label="selected"><Chip href="#" size="md" selected>Products</Chip></DsState>
          <DsState label="default"><Chip href="#" size="md">Solutions</Chip></DsState>
          <DsState label="hover"><Chip href="#" size="md" data-state="hover">Solutions</Chip></DsState>
          <DsState label="focus"><Chip href="#" size="md" data-state="focus">Solutions</Chip></DsState>
        </DsStage>
      </DsBlock>
      <DsBlock title="Props"><DsProps of="components/ui/Chip" /></DsBlock>
    </>
  )
}
