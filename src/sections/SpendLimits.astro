---
/** A static presentation of every step in Ramp's scroll-driven spending controls block. */
import Section from "../components/layout/Section.astro";
import Container from "../components/layout/Container.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import Heading from "../components/ui/Heading.astro";
import Icon from "../components/ui/Icon.astro";
import { Link as LinkIcon, Ban } from "@lucide/astro";

interface LimitCard {
  /** Source virtual-card name. */
  name: string;
  /** Source amount already spent. */
  spent: string;
  /** Source spending limit, including slash. */
  limit: string;
  /** Spent fraction represented by the HTML meter. */
  fraction: number;
}
interface Step {
  /** Exact source step heading. */
  heading: string;
  /** Exact source explanatory paragraph. */
  text: string;
}
interface Props {
  /** Full parent heading above both animation steps. */
  heading: string;
  /** First step's source heading and copy. */
  controls: Step;
  /** All virtual cards shown in the source. */
  cards: LimitCard[];
  /** Second step's source heading and copy. */
  restrictions: Step;
  /** Card name in the restrictions visual. */
  restrictedCard: string;
  /** Allowed category labels from the source. */
  allowed: string[];
  /** Blocked category labels from the source. */
  blocked: string[];
}
const { heading, controls, cards, restrictions, restrictedCard, allowed, blocked } = Astro.props;
---
<Section>
  <Container class="flex flex-col gap-12 md:gap-16">
    <SectionHeader heading={heading} align="center" />
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
      <article class="flex min-w-0 flex-col gap-8">
        <div class="grid grid-cols-2 gap-3 md:gap-4">
          {cards.map((card, index) => (
            <div class:list={[
              "flex min-w-0 flex-col justify-between rounded-xl bg-surface-2",
              index === 1 ? "col-span-2 row-start-1 min-h-52 p-6 md:min-h-56 md:p-8" : "min-h-36 gap-6 p-4 md:min-h-40 md:p-6",
            ]}>
              <div class="flex items-start justify-between gap-4">
                <p class:list={["text-ink-1", index === 1 ? "heading-h4 max-w-measure-sm" : "text-regular"]}>{card.name}</p>
                {index === 1 && <span class="shrink-0 rounded-sm bg-surface-3 p-2 text-ink-2"><Icon icon={LinkIcon} size="md" /></span>}
              </div>
              <div class="flex flex-col gap-3">
                <div class:list={["flex flex-wrap items-baseline justify-between gap-x-2 text-ink-2", index === 1 ? "text-large" : "text-small"]}><span>{card.spent}</span><span>{card.limit}</span></div>
                <div class:list={["overflow-hidden rounded-sm bg-surface-1", index === 1 ? "h-4" : "h-2"]} aria-hidden="true"><div class="h-full bg-surface-inverted-1" style={{ width: `${card.fraction * 100}%` }} /></div>
              </div>
            </div>
          ))}
        </div>
        <div class="flex max-w-measure-md flex-col gap-3"><Heading level={3} size="h3">{controls.heading}</Heading><p class="text-regular text-ink-2">{controls.text}</p></div>
      </article>
      <article class="flex min-w-0 flex-col gap-8">
        <div class="flex min-h-80 flex-col justify-between gap-16 rounded-xl bg-surface-2 p-6 md:min-h-100 md:p-8">
          <div class="flex items-start justify-between gap-6"><p class="max-w-measure-sm heading-h4 text-ink-1">{restrictedCard}</p><span class="shrink-0 rounded-sm bg-surface-3 p-2 text-ink-2"><Icon icon={LinkIcon} size="md" /></span></div>
          <div class="flex flex-col gap-3">
            <div class="flex flex-wrap gap-2">{allowed.map((label) => <span class="rounded-sm bg-surface-inverted-1 px-4 py-2 text-small text-ink-inverted">{label}</span>)}</div>
            <div class="flex flex-wrap gap-2">{blocked.map((label) => <span class="inline-flex items-center gap-2 rounded-sm border border-line-2 bg-surface-1 px-4 py-2 text-small text-ink-2"><Icon icon={Ban} size="sm" />{label}</span>)}</div>
          </div>
        </div>
        <div class="flex max-w-measure-md flex-col gap-3"><Heading level={3} size="h3">{restrictions.heading}</Heading><p class="text-regular text-ink-2">{restrictions.text}</p></div>
      </article>
    </div>
  </Container>
</Section>
