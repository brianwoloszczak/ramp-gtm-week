---
/** Ramp's site header. Existing links/action props remain supported. */
import Button from "../ui/Button.astro";
import Icon from "../ui/Icon.astro";
import { Menu, X, ChevronDown } from "@lucide/astro";
import Logo from "../../assets/brand/logo.svg";
import { SITE_NAME } from "../../../site.config.mjs";
import { navbar } from "../../data/navigation";
export interface NavLink {
  label: string;
  href: string;
  /** Source dropdown destinations, when this item opens a menu. */
  children?: { label: string; href: string; description?: string }[];
}
interface Props {
  /** Compact event navigation with a persistent action at every width. */
  compact?: boolean;
  links?: NavLink[];
  /** The primary action. */
  action?: NavLink;
  /** The source's dark signup action. */
  signup?: NavLink;
  /** Account sign-in destination. */
  signIn?: NavLink;
}
const { compact = false, links = navbar.links, action = navbar.action, signup = navbar.signup, signIn = navbar.signIn } = Astro.props;
const here = Astro.url.pathname;
---
<header data-navbar class="sticky top-0 z-40 bg-surface-1/80 text-ink-1 backdrop-blur-md">
  {compact ? <div class="px-4 md:px-8"><div class="mx-auto flex h-16 w-full max-w-frame items-center gap-3 md:gap-6"><a href="/" aria-label={SITE_NAME} class="mr-auto shrink-0"><Logo class="h-5 w-auto" /></a><nav aria-label="Main" class="flex items-center gap-3">{links.map(item => <a href={item.href} class="text-small">{item.label}</a>)}</nav><Button href={action.href} size="sm">{action.label}</Button></div></div> : <><div class="px-4 md:px-8">
    <div class="mx-auto flex h-16 w-full max-w-frame items-center gap-5">
      <a href="/" aria-label={SITE_NAME} class="mr-auto shrink-0 lg:mr-0"><Logo class="h-5 w-auto" /></a>
      <nav aria-label="Main" class="hidden items-center lg:flex">
        {links.map((item) => item.children ? (
          <details data-nav-dropdown class="group">
            <summary class="flex h-11 cursor-pointer list-none items-center gap-2 rounded-sm px-3 text-small transition-colors hover:bg-surface-2">
              {item.label}<Icon icon={ChevronDown} size="sm" />
            </summary>
            <div class="absolute inset-x-0 top-full border-y border-line bg-surface-1 px-8 py-8">
              <div class="mx-auto grid max-w-frame grid-cols-3 gap-x-8 gap-y-4">
                {item.children.map(child => <a href={child.href} class="rounded-sm p-2 text-small transition-colors hover:bg-surface-2"><span class="block">{child.label}</span>{child.description && <span class="mt-1 block text-ink-2">{child.description}</span>}</a>)}
              </div>
            </div>
          </details>
        ) : <a href={item.href} aria-current={item.href === here ? "page" : undefined} class="flex h-11 items-center rounded-sm px-3 text-small transition-colors hover:bg-surface-2">{item.label}</a>)}
      </nav>
      <div class="ml-auto hidden items-center gap-4 lg:flex">
        <a href={signIn.href} class="rounded-sm px-4 py-2 text-small transition-colors hover:bg-surface-2">{signIn.label}</a>
        <Button href={action.href} size="sm">{action.label}</Button>
        <a href={signup.href} data-tone="inverted" class="inline-flex h-8.5 shrink-0 items-center justify-center rounded-sm border border-transparent bg-surface-1 px-4 text-small text-ink-1 transition-colors hover:bg-surface-1/80 focus-visible:border-line-brand">{signup.label}</a>
      </div>
      <button type="button" data-navbar-toggle aria-label="Open the menu" aria-expanded="false" aria-controls="navbar-menu" class="grid size-10 place-items-center rounded-sm border border-transparent bg-surface-2 text-ink-1 transition-colors hover:bg-surface-2/80 focus-visible:border-line-brand focus-visible:outline-none lg:hidden">
        <span data-icon-open><Icon icon={Menu} /></span>
        <span data-icon-close class="hidden"><Icon icon={X} /></span>
      </button>
    </div>
  </div>
  <div id="navbar-menu" hidden class="max-h-screen overflow-y-auto border-t border-line bg-surface-1 px-4 pt-4 pb-6 md:px-8 lg:hidden">
    <nav aria-label="Mobile main" class="flex flex-col">
      {links.map(item => item.children ? <details class="border-b border-line"><summary class="flex cursor-pointer list-none items-center justify-between py-4 text-large">{item.label}<Icon icon={ChevronDown} size="sm" /></summary><div class="grid gap-4 pb-5">{item.children.map(child => <a href={child.href} class="rounded-sm text-regular"><span class="block">{child.label}</span>{child.description && <span class="block text-small text-ink-2">{child.description}</span>}</a>)}</div></details> : <a href={item.href} class="border-b border-line py-4 text-large">{item.label}</a>)}
      <a href={signIn.href} class="py-4 text-regular">{signIn.label}</a>
      <div class="flex flex-wrap gap-3"><Button href={action.href} size="sm">{action.label}</Button><a href={signup.href} data-tone="inverted" class="inline-flex h-8.5 shrink-0 items-center justify-center rounded-sm border border-transparent bg-surface-1 px-4 text-small text-ink-1 transition-colors hover:bg-surface-1/80 focus-visible:border-line-brand">{signup.label}</a></div>
    </nav>
  </div>
</>}
</header>
<script>
  for (const bar of document.querySelectorAll<HTMLElement>("[data-navbar]")) {
    const toggle = bar.querySelector<HTMLButtonElement>("[data-navbar-toggle]");
    const menu = bar.querySelector<HTMLElement>("#navbar-menu");
    const setOpen = (open: boolean) => {
      toggle?.setAttribute("aria-expanded", String(open));
      toggle?.setAttribute("aria-label", open ? "Close the menu" : "Open the menu");
      if (menu) menu.hidden = !open;
      bar.querySelector("[data-icon-open]")?.classList.toggle("hidden", open);
      bar.querySelector("[data-icon-close]")?.classList.toggle("hidden", !open);
    };
    toggle?.addEventListener("click", () => setOpen(toggle.getAttribute("aria-expanded") !== "true"));
    const dropdowns = bar.querySelectorAll<HTMLDetailsElement>("[data-nav-dropdown]");
    dropdowns.forEach(details => details.addEventListener("toggle", () => { if (details.open) dropdowns.forEach(other => { if (other !== details) other.open = false; }); }));
    document.addEventListener("click", event => { if (!bar.contains(event.target as Node)) dropdowns.forEach(item => item.open = false); });
    document.addEventListener("keydown", event => { if (event.key === "Escape") { setOpen(false); dropdowns.forEach(item => item.open = false); } });
    matchMedia("(min-width: 1024px)").addEventListener("change", () => setOpen(false));
  }
</script>
