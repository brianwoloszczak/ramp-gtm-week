---
import DsBlock from "../DsBlock.astro";
import DsStage from "../DsStage.astro";
import DsState from "../DsState.astro";
import DsProps from "../DsProps.astro";
import QuoteCard from "../../ui/QuoteCard.astro";

interface Props {
  /** A small preview for the overview grid. */
  thumb?: boolean;
}
const { thumb = false } = Astro.props;
---

{
  thumb ? (
    <div class="w-80 scale-75"><QuoteCard quote="Ramp has been a major upgrade for our accounting team to efficiently and effectively track spend." name="Joseph Horn" role="VP Controller" /></div>
  ) : (
    <>
      <DsBlock title="Variants" description="featured for the one that leads the testimonials.">
        <DsStage layout="states" tone="muted" cols={2} class="items-stretch">
          <DsState label="featured" class="h-full items-stretch"><QuoteCard featured quote="Ramp has been a major upgrade for our accounting team to efficiently and effectively track spend." name="Joseph Horn" role="VP Controller" /></DsState>
          <DsState label="default" class="h-full items-stretch"><QuoteCard quote="Ramp has been a major upgrade for our accounting team to efficiently and effectively track spend." name="Joseph Horn" role="VP Controller" /></DsState>
        </DsStage>
      </DsBlock>
      <DsBlock title="Props"><DsProps of="components/ui/QuoteCard" /></DsBlock>
    </>
  )
}
