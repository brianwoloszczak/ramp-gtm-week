---
import DsBlock from "../DsBlock.astro";
import DsStage from "../DsStage.astro";
import DsState from "../DsState.astro";
import DsProps from "../DsProps.astro";
import Checkbox from "../../ui/Checkbox.astro";

interface Props {
  /** A small preview for the overview grid. */
  thumb?: boolean;
}
const { thumb = false } = Astro.props;
---

{
  thumb ? (
    <div class="flex flex-col gap-2"><Checkbox label="Products" checked /><Checkbox label="Solutions" /></div>
  ) : (
    <>
      <DsBlock title="States" description="Same states as the fields.">
        <DsStage layout="states" cols={3}>
          <DsState label="default"><Checkbox label="Products" /></DsState>
          <DsState label="hover"><Checkbox label="Products" data-state="hover" /></DsState>
          <DsState label="focus"><Checkbox label="Products" data-state="focus" /></DsState>
          <DsState label="checked"><Checkbox label="Products" checked /></DsState>
          <DsState label="disabled"><Checkbox label="Products" disabled /></DsState>
          <DsState label="error"><Checkbox label="Products" error="What’s your work email?" /></DsState>
        </DsStage>
      </DsBlock>
      <DsBlock title="Props"><DsProps of="components/ui/Checkbox" /></DsBlock>
    </>
  )
}
