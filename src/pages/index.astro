---
import Base from "../layouts/Base.astro";
import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";
import { sections } from "../sections";
import AnnouncementBar from "../sections/AnnouncementBar.astro";
import HeroEmail from "../sections/HeroEmail.astro";
import LogoWall from "../sections/LogoWall.astro";
import PlatformBento from "../sections/PlatformBento.astro";
import SpendLimits from "../sections/SpendLimits.astro";
import TwoPanels from "../sections/TwoPanels.astro";
import SpendCalculator from "../sections/SpendCalculator.astro";
import Testimonials from "../sections/Testimonials.astro";
import Faq from "../sections/Faq.astro";
import ClosingBand from "../sections/ClosingBand.astro";
const images = sections["platform-bento"].example.tiles;
const sourceQuotes = sections.testimonials.example.rows.flat();
const quotes = [
{ name: "Matteo Franceschetti", role: "CEO, Eight Sleep", quote: "Ramp was a complete game changer. It's a single platform that can handle every aspect of our spending.", logo: sourceQuotes.find(q => q.name === "Matteo Franceschetti")?.logo },
{ name: "Michael Bohn", role: "Head of Business Operations, Foursquare", quote: "The average person can figure Ramp out without training. That's what drives 100% adoption." },
{ name: "Andrew Clarke", role: "SVP Finance, Studs", quote: "We've consolidated four platforms into one with Ramp." },
{ name: "Tzu-San Hung", role: "Head of Strategic Finance, Notion", quote: "Beautiful tools use beautiful tools.", logo: sourceQuotes.find(q => q.name === "Tzu-San Hung")?.logo },
{ name: "Christine Mimnagh-Fleming", role: "Sr. Manager, Finance Transformation, Shopify", quote: "Ramp is so intuitive, people get it right away.", featured: true },
];
const faqs = [
...sections.faq.example.items.slice(0, 2),
{ question: "How long does switching take?", answer: "[Answer from the account team: how long a switch takes]" },
{ question: "What happens after the 3 months?", answer: "Your account moves to Ramp Free unless you choose to stay on Plus. You can upgrade or downgrade anytime within your Ramp dashboard." },
];
---
<Base title="GTM Tech Week offer: 3 months of Ramp Plus free" description="For the founders and GTM leaders we met at GTM Tech Week: book a 20-minute demo by 15 December for 3 months of Ramp Plus free and $500 in travel credit." jsonLd={[{ "@type": "FAQPage", mainEntity: faqs.map(f => ({ "@type": "Question", name: f.question, acceptedAnswer: { "@type": "Answer", text: f.answer } })) }]}>
<AnnouncementBar {...sections["announcement-bar"].example} message="For people we met at GTM Tech Week · offer ends 15 December" linkLabel="Claim your offer" href="#claim" />
<Navbar compact links={[{ label: "Pricing", href: "https://ramp.com/pricing" }]} action={{ label: "Claim your offer", href: "#claim" }} />
<main data-gtm-landing>
<HeroEmail {...sections["hero-email"].example} tagline="GTM Tech Week follow-up" showCounter={false} heading="Your GTM stack runs on cards, credits and renewals." muted="Ramp runs all three." lead="Cards for events and dinners, control over AI spend, every renewal tracked: one platform for the budget you run." emailLabel="Work email" emailPlaceholder="Work email" buttonLabel="Claim your offer" />
<LogoWall {...sections["logo-wall"].example} />
<PlatformBento heading="Ramp for GTM teams." muted="" actions={[]} tiles={[
{ ...images[0], title: "Corporate cards", description: "with per-rep limits for events and dinners", href: "https://ramp.com/corporate-cards" },
{ ...images[1], title: "AI Spend Management", description: "for Clay credits, LLM tokens and seats", href: "https://ramp.com/ai-cost-monitoring" },
{ ...images[4], title: "Vendor Management", description: "contracts and renewals, tracked", href: "https://ramp.com/vendor-management" },
{ ...images[3], title: "Travel", description: "booked in policy", href: "https://ramp.com/travel" },
{ ...images[2], title: "Expense Management", description: "no more expense reports", href: "https://ramp.com/expense-management" },
]} />
<SpendLimits {...sections["spend-limits"].example} heading="A card for every GTM budget" featuredCardIndex={0} cards={[
{ name: "Conference card", spent: "$2,500", limit: "/$3,000", fraction: 2500/3000 },
{ name: "Field marketing card", spent: "$1,120", limit: "/$10,000", fraction: 1120/10000 },
{ name: "Team dinners card", spent: "$123", limit: "/$500", fraction: 123/500 },
]} restrictedCard="Team dinners card" />
<TwoPanels {...sections["two-panels"].example} />
<SpendCalculator {...sections["spend-calculator"].example} />
<Testimonials heading="We've got the receipts." lead="85,000+ companies" rows={[[quotes[4], quotes[0], quotes[1], quotes[3], quotes[2]], [quotes[1], quotes[3], quotes[2], quotes[4], quotes[0]], [quotes[2], quotes[4], quotes[0], quotes[1], quotes[3]]]} />
<Faq heading="FAQ" items={faqs} />
<ClosingBand id="claim" heading="Time is money. Save both." lead="Book a demo by 15 December: 3 months of Ramp Plus free and $500 in travel credit." emailLabel="Work email" emailPlaceholder="Work email" buttonLabel="Claim your offer" />
</main>
<Footer minimal copyright="Ramp — demo page" />
</Base>
<script>
  // Keep validation but never send email data to an unconfigured endpoint.
  document.querySelectorAll<HTMLFormElement>("[data-gtm-landing] form").forEach(form => {
    form.addEventListener("submit", event => {
      event.preventDefault();
      const email = form.querySelector<HTMLInputElement>('input[type="email"]');
      email?.setCustomValidity("[Demo booking form not connected]");
      email?.reportValidity();
    });
    form.addEventListener("input", () => form.querySelector<HTMLInputElement>('input[type="email"]')?.setCustomValidity(""));
  });
</script>
