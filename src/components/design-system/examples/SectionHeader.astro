---
import DsBlock from "../DsBlock.astro";
import DsStage from "../DsStage.astro";
import DsProps from "../DsProps.astro";
import SectionHeader from "../../ui/SectionHeader.astro";
import Tagline from "../../ui/Tagline.astro";
import Heading from "../../ui/Heading.astro";

interface Props {
  /** A small preview for the overview grid. */
  thumb?: boolean;
}
const { thumb = false } = Astro.props;
---

{
  thumb ? (
    <div class="flex flex-col gap-2"><Tagline>Products</Tagline><Heading level={3} size="h5" muted="that handle themselves">Cards & Expenses</Heading></div>
  ) : (
    <>
      <DsBlock title="Left" description="Tagline, heading with an optional muted tail, lead, actions. The default.">
        <DsStage layout="start">
          <SectionHeader
            tagline="Products"
            heading="Cards & Expenses"
            muted="that handle themselves"
            lead="Join the 85,000+ businesses simplifying their finances with Ramp."
            actions={[{ label: "Get started", href: "#" }, { label: "See a demo", href: "#" }]}
          />
        </DsStage>
      </DsBlock>
      <DsBlock title="Centre" description="For a closing band or a short section.">
        <DsStage>
          <SectionHeader align="center" tagline="Products" heading="Time is money. Save both." lead="Save money and time. All with one corporate card." />
        </DsStage>
      </DsBlock>
      <DsBlock title="Props"><DsProps of="components/ui/SectionHeader" /></DsBlock>
    </>
  )
}
