---
/** A static presentation of every step in Ramp's scroll-driven spending controls block. */
import Section from "../components/layout/Section.astro";
import Container from "../components/layout/Container.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import Heading from "../components/ui/Heading.astro";
import Icon from "../components/ui/Icon.astro";
import { Link as LinkIcon, Ban } from "@lucide/astro";

interface LimitCard {
  /** Source virtual-card name. */
  name: string;
  /** Source amount already spent. */
  spent: string;
  /** Source spending limit, including slash. */
  limit: string;
  /** Spent fraction represented by the HTML meter. */
  fraction: number;
}
interface Step {
  /** Exact source step heading. */
  heading: string;
  /** Exact source explanatory paragraph. */
  text: string;
}
interface Props {
  /** Full parent heading above both animation steps. */
  heading: string;
  /** First step's source heading and copy. */
  controls: Step;
  /** All virtual cards shown in the source. */
  cards: LimitCard[];
  /** Second step's source heading and copy. */
  restrictions: Step;
  /** Card name in the restrictions visual. */
  restrictedCard: string;
  /** Allowed category labels from the source. */
  allowed: string[];
  /** Blocked category labels from the source. */
  blocked: string[];
}
const { heading, controls, cards, restrictions, restrictedCard, allowed, blocked } = Astro.props;
---
<Section>
  <Container class="flex flex-col gap-10 md:gap-12">
    <SectionHeader heading={heading} align="center" />
    <div class="grid gap-12 lg:grid-cols-2">
      <article class="flex min-w-0 flex-col gap-8">
        <div class="grid gap-4 md:min-h-64 md:grid-cols-3 lg:min-h-72">
          {cards.map((card) => (
            <div class="flex min-w-0 flex-col justify-between gap-6 rounded-xl bg-surface-2 p-6">
              <p class="text-medium text-ink-1">{card.name}</p>
              <div class="flex justify-between gap-2 text-regular text-ink-2"><span>{card.spent}</span><span>{card.limit}</span></div>
              <div class="h-3 overflow-hidden rounded-sm bg-surface-1" aria-hidden="true"><div class="h-full bg-surface-inverted-1" style={{ width: `${card.fraction * 100}%` }} /></div>
            </div>
          ))}
        </div>
        <div class="flex flex-col gap-3"><Heading level={3} size="h3">{controls.heading}</Heading><p class="max-w-measure-md text-regular text-ink-2">{controls.text}</p></div>
      </article>
      <article class="flex min-w-0 flex-col gap-8">
        <div class="flex min-h-72 flex-col justify-between gap-12 rounded-xl bg-surface-2 p-6 md:min-h-64 lg:min-h-72">
          <div class="flex items-start justify-between gap-6"><p class="max-w-measure-sm heading-h3 text-ink-1">{restrictedCard}</p><span class="rounded-sm bg-surface-3 p-2 text-ink-2"><Icon icon={LinkIcon} size="md" /></span></div>
          <div class="flex flex-col gap-2">
            <div class="flex flex-wrap gap-2">{allowed.map((label) => <span class="rounded-sm bg-surface-inverted-1 px-4 py-2 text-small text-ink-inverted">{label}</span>)}</div>
            <div class="flex flex-wrap gap-2">{blocked.map((label) => <span class="inline-flex items-center gap-2 rounded-sm border border-line-2 bg-surface-1 px-4 py-2 text-small text-ink-2"><Icon icon={Ban} size="sm" />{label}</span>)}</div>
          </div>
        </div>
        <div class="flex flex-col gap-3"><Heading level={3} size="h3">{restrictions.heading}</Heading><p class="max-w-measure-md text-regular text-ink-2">{restrictions.text}</p></div>
      </article>
    </div>
  </Container>
</Section>
